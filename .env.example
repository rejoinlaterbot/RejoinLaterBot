# Development only. Production uses the *_FILE variables shown in docker-compose.yml.
# Generate each 32-byte key with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TELEGRAM_BOT_TOKEN=
DATA_ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=
DATABASE_URL=postgresql+asyncpg://rejoinlater:change-me@127.0.0.1:5432/rejoinlater

BOT_USERNAME=RejoinLaterBot
LOG_LEVEL=INFO
SCHEDULER_INTERVAL_SECONDS=45
SCHEDULER_BATCH_SIZE=100
INVITE_TTL_HOURS=24
MAX_CUSTOM_DAYS=3650
BACKUP_RETENTION_DAYS=7
